def test_creer_refuse_une_relation_inexistante(client: TestClient) -> None:
    donnees = donnees_valides(client)
    donnees["{{ relations[0].attribut }}"] = 999999

    assert client.post(URL, json=donnees).status_code == 422
{% endif %}
