def test_supprimer_un_element_utilise_renvoie_409(client: TestClient) -> None:
    donnees = donnees_valides(client)
    client.post(URL, json=donnees)

    reponse = client.delete(f"/api/{{ relation_restreinte.url }}/{donnees['{{ relation_restreinte.attribut }}']}")

    assert reponse.status_code == 409
