"""Tests de l'API : {{ pluriel_libelle | lower }}."""

{{ imports_test }}

URL = "/api/{{ pluriel_url }}"
{% if protege %}

def test_{{ nom_pluriel }}_exigent_un_utilisateur_connecte(client: TestClient) -> None:
    assert client.get(URL).status_code == 401
    assert client.post(URL, json={}).status_code == 401
{% else %}
DONNEES = {
{%- for champ in champs if not champ.est_fk %}
    "{{ champ.nom }}": {{ champ.exemple }},
{%- endfor %}
}
{% if utilisateur_cible %}

def _creer_utilisateur(client: TestClient) -> int:
    """Crée un compte (e-mail unique) et retourne son identifiant."""
    reponse = client.post("/api/auth/inscription", json={
        "email": f"{uuid.uuid4().hex[:8]}@exemple.com",
        "nom_complet": "Utilisateur de test",
        "mot_de_passe": "motdepasse123",
    })
    return reponse.json()["id"]
{% endif %}

def donnees_valides(client: TestClient) -> dict:
    """Données valides pour créer : {{ nom_libelle | lower }} (les éléments liés sont créés au besoin)."""
    donnees = dict(DONNEES)
{%- for r in relations if not r.auto %}
{%- if r.cible == "utilisateur" %}
    donnees["{{ r.attribut }}"] = _creer_utilisateur(client)
{%- else %}
    donnees["{{ r.attribut }}"] = client.post("/api/{{ r.url }}", json=donnees_{{ r.cible }}(client)).json()["id"]
{%- endif %}
{%- endfor %}
    return donnees


def test_creer_puis_lire_{{ nom_snake }}(client: TestClient) -> None:
    creation = client.post(URL, json=donnees_valides(client))
    assert creation.status_code == 201
    identifiant = creation.json()["id"]

    lecture = client.get(f"{URL}/{identifiant}")
    assert lecture.status_code == 200
    assert lecture.json()["id"] == identifiant


def test_lister_{{ nom_pluriel }}(client: TestClient) -> None:
    client.post(URL, json=donnees_valides(client))

    reponse = client.get(URL)

    assert reponse.status_code == 200
    assert len(reponse.json()) == 1


def test_modifier_{{ nom_snake }}(client: TestClient) -> None:
    donnees = donnees_valides(client)
    identifiant = client.post(URL, json=donnees).json()["id"]
    champ = "{{ champs[0].nom }}"

    reponse = client.patch(f"{URL}/{identifiant}", json={champ: donnees[champ]})

    assert reponse.status_code == 200


def test_supprimer_{{ nom_snake }}(client: TestClient) -> None:
    identifiant = client.post(URL, json=donnees_valides(client)).json()["id"]

    assert client.delete(f"{URL}/{identifiant}").status_code == 204
    assert client.get(f"{URL}/{identifiant}").status_code == 404


def test_{{ nom_snake }}_inconnu_renvoie_404(client: TestClient) -> None:
    assert client.get(f"{URL}/999999").status_code == 404
{% if a_champ_obligatoire %}

def test_creation_invalide_renvoie_422(client: TestClient) -> None:
    assert client.post(URL, json={}).status_code == 422


def test_modifier_refuse_null_sur_un_champ_obligatoire(client: TestClient) -> None:
    identifiant = client.post(URL, json=donnees_valides(client)).json()["id"]

    reponse = client.patch(f"{URL}/{identifiant}", json={"{{ champs_obligatoires[0] }}": None})

    assert reponse.status_code == 422
{% endif %}
{% for r in relations if r.auto %}

def test_associer_{{ r.relation }}(client: TestClient) -> None:
    parent = client.post(URL, json=donnees_valides(client)).json()["id"]

    reponse = client.post(URL, json={**donnees_valides(client), "{{ r.attribut }}": parent})

    assert reponse.status_code == 201
    assert reponse.json()["{{ r.attribut }}"] == parent


def test_supprimer_{{ r.relation }}_conserve_les_enfants(client: TestClient) -> None:
    parent = client.post(URL, json=donnees_valides(client)).json()["id"]
    enfant = client.post(URL, json={**donnees_valides(client), "{{ r.attribut }}": parent}).json()["id"]

    assert client.delete(f"{URL}/{parent}").status_code == 204
    assert client.get(f"{URL}/{enfant}").status_code == 200
{% endfor %}
{% for a in m2m %}

def test_associer_des_{{ a.attribut }}(client: TestClient) -> None:
    donnees = donnees_valides(client)
{%- if a.cible == "utilisateur" %}
    id_lie = _creer_utilisateur(client)
{%- else %}
    id_lie = client.post("/api/{{ a.url }}", json=donnees_{{ a.cible }}(client)).json()["id"]
{%- endif %}

    creation = client.post(URL, json={**donnees, "{{ a.ids }}": [id_lie]})

    assert creation.status_code == 201
    assert creation.json()["{{ a.ids }}"] == [id_lie]
    modification = client.patch(f"{URL}/{creation.json()['id']}", json={"{{ a.ids }}": []})
    assert modification.status_code == 200
    assert modification.json()["{{ a.ids }}"] == []


def test_associer_{{ a.attribut }}_inexistants_renvoie_422(client: TestClient) -> None:
    reponse = client.post(URL, json={**donnees_valides(client), "{{ a.ids }}": [999999]})

    assert reponse.status_code == 422
{% endfor %}
