"""Logique métier : {{ nom_libelle | lower }}."""

from sqlalchemy import {% if champs_recherche %}or_, {% endif %}select
from sqlalchemy.orm import Session{% if m2m %}, selectinload{% endif %}

{% for cible in cibles_m2m -%}
from app.modeles.{{ cible.snake }} import {{ cible.classe }}
{% endfor -%}
from app.modeles.{{ nom_snake }} import {{ nom_classe }}
from app.schemas.{{ nom_snake }} import {{ nom_classe }}Creation, {{ nom_classe }}MiseAJour
{% if m2m %}

def _charger(session: Session, modele: type, identifiants: list[int]) -> list:
    """Retrouve les éléments liés à partir de leurs identifiants (les doublons sont ignorés)."""
    if not identifiants:
        return []
    return list(session.scalars(select(modele).where(modele.id.in_(set(identifiants)))))
{% endif %}

def lister(
    session: Session,
    *,
    saut: int = 0,
    limite: int = 50,
{%- if champs_recherche %}
    q: str | None = None,
{%- endif %}
    tri: str = "id",
{%- if champs_filtre %}
    filtres: dict | None = None,
{%- endif %}
) -> list[{{ nom_classe }}]:
    requete = select({{ nom_classe }})
{%- if champs_filtre %}
    for champ, valeur in (filtres or {}).items():
        requete = requete.where(getattr({{ nom_classe }}, champ) == valeur)
{%- endif %}
{%- if champs_recherche %}
    if q:
        motif = "%" + q.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%"
        requete = requete.where(or_(
{%- for nom in champs_recherche %}
            {{ nom_classe }}.{{ nom }}.ilike(motif, escape="\\"),
{%- endfor %}
        ))
{%- endif %}
    colonne = getattr({{ nom_classe }}, tri.lstrip("-"))
    requete = requete.order_by(colonne.desc() if tri.startswith("-") else colonne, {{ nom_classe }}.id)
    requete = requete.offset(saut).limit(limite)
{%- if m2m %}
    requete = requete.options({% for a in m2m %}selectinload({{ nom_classe }}.{{ a.attribut }}){% if not loop.last %}, {% endif %}{% endfor %})
{%- endif %}
    return list(session.scalars(requete))


def obtenir(session: Session, identifiant: int) -> {{ nom_classe }} | None:
    return session.get({{ nom_classe }}, identifiant)


def creer(session: Session, donnees: {{ nom_classe }}Creation) -> {{ nom_classe }}:
{%- if m2m %}
    objet = {{ nom_classe }}(**donnees.model_dump(exclude={ {%- for a in m2m %}"{{ a.ids }}"{% if not loop.last %}, {% endif %}{% endfor -%} }))
{%- for a in m2m %}
    objet.{{ a.attribut }} = _charger(session, {{ a.classe }}, donnees.{{ a.ids }})
{%- endfor %}
{%- else %}
    objet = {{ nom_classe }}(**donnees.model_dump())
{%- endif %}
    session.add(objet)
    session.commit()
    session.refresh(objet)
    return objet


def mettre_a_jour(
    session: Session, objet: {{ nom_classe }}, donnees: {{ nom_classe }}MiseAJour
) -> {{ nom_classe }}:
    valeurs = donnees.model_dump(exclude_unset=True)
{%- for a in m2m %}
    identifiants = valeurs.pop("{{ a.ids }}", None)
    if identifiants is not None:
        objet.{{ a.attribut }} = _charger(session, {{ a.classe }}, identifiants)
{%- endfor %}
    for champ, valeur in valeurs.items():
        setattr(objet, champ, valeur)
    session.commit()
    session.refresh(objet)
    return objet


def supprimer(session: Session, objet: {{ nom_classe }}) -> None:
    session.delete(objet)
    session.commit()
