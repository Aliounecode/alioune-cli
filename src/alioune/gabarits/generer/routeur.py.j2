"""Routes : {{ nom_libelle | lower }}."""

from typing import Annotated

from fastapi import APIRouter, {% if protege %}Depends, {% endif %}HTTPException, Query, status
{% if m2m %}from sqlalchemy import func, select
{% endif %}from sqlalchemy.exc import IntegrityError

from app.base_de_donnees import SessionDep
{% if protege -%}
from app.dependances import utilisateur_courant
{% endif -%}
{% for cible in cibles -%}
from app.modeles.{{ cible.snake }} import {{ cible.classe }}
{% endfor -%}
from app.modeles.{{ nom_snake }} import {{ nom_classe }}
from app.schemas.{{ nom_snake }} import {{ nom_classe }}Creation, {{ nom_classe }}Lecture, {{ nom_classe }}MiseAJour
from app.services import {{ nom_snake }} as service_{{ nom_snake }}

routeur = APIRouter(
    prefix="/{{ pluriel_url }}",
    tags=["{{ pluriel_libelle }}"],
{%- if protege %}
    dependencies=[Depends(utilisateur_courant)],
{%- endif %}
)


def _obtenir_ou_404(session: SessionDep, identifiant: int) -> {{ nom_classe }}:
    objet = service_{{ nom_snake }}.obtenir(session, identifiant)
    if objet is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="{{ nom_libelle }} introuvable")
    return objet
{% if relations or m2m %}

def _verifier_relations(
    session: SessionDep, donnees: {{ nom_classe }}Creation | {{ nom_classe }}MiseAJour
) -> None:
    """Refuse (422) une relation vers un élément qui n'existe pas."""
{%- for r in relations %}
    identifiant = getattr(donnees, "{{ r.attribut }}", None)
    if identifiant is not None and session.get({{ r.classe }}, identifiant) is None:
        raise HTTPException(status_code=422, detail="{{ r.libelle }} introuvable")
{%- endfor %}
{%- for a in m2m %}
    identifiants = set(getattr(donnees, "{{ a.ids }}", None) or [])
    if identifiants:
        existants = session.scalar(
            select(func.count()).select_from({{ a.classe }}).where({{ a.classe }}.id.in_(identifiants))
        )
        if existants != len(identifiants):
            raise HTTPException(status_code=422, detail="{{ a.libelle }} introuvable")
{%- endfor %}
{% endif %}

@routeur.get("", response_model=list[{{ nom_classe }}Lecture])
def lister_{{ nom_pluriel }}(
    session: SessionDep,
    saut: Annotated[int, Query(ge=0)] = 0,
    limite: Annotated[int, Query(ge=1, le=200)] = 50,
{%- if champs_recherche %}
    q: Annotated[
        str | None,
        Query(max_length=100, description="Recherche dans : {{ champs_recherche | join(', ') }}"),
    ] = None,
{%- endif %}
    tri: Annotated[
        str,
        Query(pattern=r"{{ tri_motif }}", description="Champ de tri ; préfixe « - » pour l'ordre décroissant"),
    ] = "id",
{%- for f in champs_filtre %}
    {{ f.nom }}: {{ "int" if f.est_fk else "bool" }} | None = None,
{%- endfor %}
) -> list[{{ nom_classe }}]:
    """Liste paginée et triable{% if champs_recherche %}, avec recherche{% endif %}{% if champs_filtre %}, avec filtres{% endif %} : {{ pluriel_libelle | lower }}."""
{%- if champs_filtre %}
    filtres = {
{%- for f in champs_filtre %}
        "{{ f.nom }}": {{ f.nom }},
{%- endfor %}
    }
{%- endif %}
    return service_{{ nom_snake }}.lister(
        session,
        saut=saut,
        limite=limite,
{%- if champs_recherche %}
        q=q,
{%- endif %}
        tri=tri,
{%- if champs_filtre %}
        filtres={cle: valeur for cle, valeur in filtres.items() if valeur is not None},
{%- endif %}
    )


@routeur.get("/{identifiant}", response_model={{ nom_classe }}Lecture)
def lire_{{ nom_snake }}(identifiant: int, session: SessionDep) -> {{ nom_classe }}:
    return _obtenir_ou_404(session, identifiant)


@routeur.post("", response_model={{ nom_classe }}Lecture, status_code=status.HTTP_201_CREATED)
def creer_{{ nom_snake }}(donnees: {{ nom_classe }}Creation, session: SessionDep) -> {{ nom_classe }}:
{%- if relations or m2m %}
    _verifier_relations(session, donnees)
{%- endif %}
    return service_{{ nom_snake }}.creer(session, donnees)


@routeur.patch("/{identifiant}", response_model={{ nom_classe }}Lecture)
def modifier_{{ nom_snake }}(
    identifiant: int, donnees: {{ nom_classe }}MiseAJour, session: SessionDep
) -> {{ nom_classe }}:
    objet = _obtenir_ou_404(session, identifiant)
{%- if relations or m2m %}
    _verifier_relations(session, donnees)
{%- endif %}
    return service_{{ nom_snake }}.mettre_a_jour(session, objet, donnees)


@routeur.delete("/{identifiant}", status_code=status.HTTP_204_NO_CONTENT)
def supprimer_{{ nom_snake }}(identifiant: int, session: SessionDep) -> None:
    objet = _obtenir_ou_404(session, identifiant)
    try:
        service_{{ nom_snake }}.supprimer(session, objet)
    except IntegrityError:
        session.rollback()
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="Suppression impossible : cet élément est utilisé par d'autres données",
        ) from None
